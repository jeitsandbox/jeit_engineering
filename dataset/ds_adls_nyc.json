{
	"name": "ds_adls_nyc",
	"properties": {
		"linkedServiceName": {
			"referenceName": "ls_adls_container",
			"type": "LinkedServiceReference"
		},
		"parameters": {
			"taxiType": {
				"type": "string"
			},
			"year": {
				"type": "int"
			},
			"month": {
				"type": "string"
			}
		},
		"annotations": [],
		"type": "Parquet",
		"typeProperties": {
			"location": {
				"type": "AzureBlobFSLocation",
				"fileName": {
					"value": "@concat(dataset().taxiType, '_tripdata_',string(dataset().year),'-',dataset().month)",
					"type": "Expression"
				},
				"folderPath": {
					"value": "@concat('in/nyc_tlc/',dataset().taxiType,'/',string(dataset().year))",
					"type": "Expression"
				},
				"fileSystem": "raw"
			},
			"compressionCodec": "snappy"
		},
		"schema": []
	}
}