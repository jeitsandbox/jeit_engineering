{
	"name": "df_silver_dim_coin_coingecko",
	"properties": {
		"folder": {
			"name": "cryptosense_kp"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "ds_blob_bronze_coingecko_json_read",
						"type": "DatasetReference"
					},
					"name": "src1coingecko"
				}
			],
			"sinks": [],
			"transformations": [
				{
					"name": "slt1coingecko"
				}
			],
			"scriptLines": [
				"source(output(",
				"          ath as double,",
				"          ath_change_percentage as double,",
				"          ath_date as string,",
				"          atl as double,",
				"          atl_change_percentage as double,",
				"          atl_date as string,",
				"          circulating_supply as double,",
				"          current_price as double,",
				"          fully_diluted_valuation as double,",
				"          high_24h as double,",
				"          id as string,",
				"          image as string,",
				"          last_updated as string,",
				"          low_24h as double,",
				"          market_cap as long,",
				"          market_cap_change_24h as double,",
				"          market_cap_change_percentage_24h as double,",
				"          market_cap_rank as short,",
				"          max_supply as double,",
				"          name as string,",
				"          price_change_24h as double,",
				"          price_change_percentage_24h as double,",
				"          price_change_percentage_24h_in_currency as double,",
				"          roi as (currency as string, percentage as double, times as double),",
				"          symbol as string,",
				"          total_supply as double,",
				"          total_volume as double",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     documentForm: 'documentPerLine',",
				"     wildcardPaths:['coingecko/markets/*/*.json']) ~> src1coingecko",
				"src1coingecko select(mapColumn(",
				"          ath,",
				"          ath_change_percentage,",
				"          ath_date,",
				"          atl,",
				"          atl_change_percentage,",
				"          atl_date,",
				"          circulating_supply,",
				"          current_price,",
				"          fully_diluted_valuation,",
				"          high_24h,",
				"          id,",
				"          image,",
				"          last_updated,",
				"          low_24h,",
				"          market_cap,",
				"          market_cap_change_24h,",
				"          market_cap_change_percentage_24h,",
				"          market_cap_rank,",
				"          max_supply,",
				"          name,",
				"          price_change_24h,",
				"          price_change_percentage_24h,",
				"          price_change_percentage_24h_in_currency,",
				"          roi,",
				"          symbol,",
				"          total_supply,",
				"          total_volume",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> slt1coingecko"
			]
		}
	}
}