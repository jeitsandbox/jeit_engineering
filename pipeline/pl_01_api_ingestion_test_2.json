{
	"name": "pl_01_api_ingestion_test_2",
	"properties": {
		"activities": [
			{
				"name": "Get World Bank Data",
				"description": "Get World Bank Data",
				"type": "Copy",
				"dependsOn": [
					{
						"activity": "Set country variable",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "RestSource",
						"httpRequestTimeout": "00:01:40",
						"requestInterval": "00.00:00:00.010",
						"requestMethod": "GET",
						"paginationRules": {
							"supportRFC5988": "true"
						}
					},
					"sink": {
						"type": "JsonSink",
						"storeSettings": {
							"type": "AzureBlobFSWriteSettings",
							"copyBehavior": "FlattenHierarchy"
						},
						"formatSettings": {
							"type": "JsonWriteSettings"
						}
					},
					"enableStaging": false
				},
				"inputs": [
					{
						"referenceName": "ds_json_data",
						"type": "DatasetReference",
						"parameters": {
							"country_name": {
								"value": "@variables('CountryAbbr')",
								"type": "Expression"
							}
						}
					}
				],
				"outputs": [
					{
						"referenceName": "ds_worldbank_json",
						"type": "DatasetReference",
						"parameters": {
							"file_name": "jamica_gov_data.json",
							"storage_path": "in/Country"
						}
					}
				]
			},
			{
				"name": "Set country variable",
				"description": "Set country variable",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "CountryAbbr",
					"value": "JAM"
				}
			}
		],
		"variables": {
			"CountryAbbr": {
				"type": "String"
			}
		},
		"folder": {
			"name": "Test2"
		},
		"annotations": []
	}
}