{
	"name": "pl_airline_master",
	"properties": {
		"activities": [
			{
				"name": "Execute source_to_raw",
				"type": "ExecutePipeline",
				"dependsOn": [
					{
						"activity": "Set variable runTime",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"pipeline": {
						"referenceName": "pl_source_to_raw_airline",
						"type": "PipelineReference"
					},
					"waitOnCompletion": true,
					"parameters": {
						"p_ingestionDate": {
							"value": "@variables('v_runDate')",
							"type": "Expression"
						},
						"p_runTime": {
							"value": "@variables('v_runTime')",
							"type": "Expression"
						},
						"p_flightDate": {
							"value": "@pipeline().parameters.p_flightDate",
							"type": "Expression"
						},
						"p_apiKey": {
							"value": "@pipeline().parameters.p_apiKey",
							"type": "Expression"
						},
						"p_airports": {
							"value": "@pipeline().parameters.p_airports",
							"type": "Expression"
						}
					}
				}
			},
			{
				"name": "Execute raw_trusted",
				"type": "ExecutePipeline",
				"dependsOn": [
					{
						"activity": "Execute source_to_raw",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"pipeline": {
						"referenceName": "pl_raw_to_trusted_airline",
						"type": "PipelineReference"
					},
					"waitOnCompletion": true,
					"parameters": {
						"p_ingestionDate": {
							"value": "@pipeline().parameters.p_flightDate",
							"type": "Expression"
						},
						"p_raw_path": {
							"value": "@pipeline().parameters.p_raw_path",
							"type": "Expression"
						},
						"p_trusted_table": {
							"value": "@pipeline().parameters.p_trusted_table",
							"type": "Expression"
						}
					}
				}
			},
			{
				"name": "Execute trusted_provisioned",
				"type": "ExecutePipeline",
				"state": "Inactive",
				"onInactiveMarkAs": "Succeeded",
				"dependsOn": [
					{
						"activity": "Execute raw_trusted",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"pipeline": {
						"referenceName": "pl_trusted_to_provisioned_airline",
						"type": "PipelineReference"
					},
					"waitOnCompletion": true
				}
			},
			{
				"name": "Set variable runDate",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "v_runDate",
					"value": {
						"value": "@formatDateTime(utcNow(), 'yyyy-MM-dd')",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Set variable runTime",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "Set variable runDate",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "v_runTime",
					"value": {
						"value": "@formatDateTime(utcNow(), 'HHmm')",
						"type": "Expression"
					}
				}
			}
		],
		"parameters": {
			"p_flightDate": {
				"type": "string",
				"defaultValue": "2026-03-11"
			},
			"p_apiKey": {
				"type": "string",
				"defaultValue": "92bb3268b5d133d2489e40e3cf3fd07d"
			},
			"p_raw_path": {
				"type": "string",
				"defaultValue": "abfss://raw@jeitstorageaccountdev.dfs.core.windows.net/airlineperformance/flights/"
			},
			"p_trusted_table": {
				"type": "string",
				"defaultValue": "trusted_airline.flight_delays"
			},
			"p_airports": {
				"type": "array",
				"defaultValue": [
					"MKJP",
					"MKJS",
					"MKBS"
				]
			},
			"p_directions": {
				"type": "array",
				"defaultValue": [
					"arr",
					"dep"
				]
			}
		},
		"variables": {
			"v_runDate": {
				"type": "String"
			},
			"v_runTime": {
				"type": "String"
			}
		},
		"annotations": []
	}
}