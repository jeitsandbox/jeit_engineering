{
	"name": "pl_01_api_ingestion_foreach_loop_from_file",
	"properties": {
		"activities": [
			{
				"name": "Country List",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "CountryList",
					"value": [
						"JAM",
						"USA",
						"BEN",
						"ALB",
						"DZA"
					]
				}
			},
			{
				"name": "ForEach1",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "Country List",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@variables('CountryList')",
						"type": "Expression"
					},
					"isSequential": true,
					"activities": [
						{
							"name": "Get World Bank Data_copy1",
							"description": "Get World Bank Data",
							"type": "Copy",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "RestSource",
									"httpRequestTimeout": "00:01:40",
									"requestInterval": "00.00:00:00.010",
									"requestMethod": "GET",
									"paginationRules": {
										"supportRFC5988": "true"
									}
								},
								"sink": {
									"type": "JsonSink",
									"storeSettings": {
										"type": "AzureBlobFSWriteSettings",
										"copyBehavior": "FlattenHierarchy"
									},
									"formatSettings": {
										"type": "JsonWriteSettings"
									}
								},
								"enableStaging": false
							},
							"inputs": [
								{
									"referenceName": "ds_json_data",
									"type": "DatasetReference",
									"parameters": {
										"country_name": {
											"value": "@item()",
											"type": "Expression"
										}
									}
								}
							],
							"outputs": [
								{
									"referenceName": "ds_worldbank_json",
									"type": "DatasetReference",
									"parameters": {
										"file_name": {
											"value": "@concat(item(),'.json')",
											"type": "Expression"
										},
										"storage_path": {
											"value": "@concat('in/Country/',item())",
											"type": "Expression"
										}
									}
								}
							]
						}
					]
				}
			}
		],
		"variables": {
			"CountryAbbr": {
				"type": "String"
			},
			"CountryList": {
				"type": "Array"
			},
			"CountryItem": {
				"type": "String"
			}
		},
		"folder": {
			"name": "Quick Synch Foreach Loop"
		},
		"annotations": []
	}
}