{
	"name": "pl_source_to_raw_airline",
	"properties": {
		"activities": [
			{
				"name": "ForEach Airport",
				"type": "ForEach",
				"dependsOn": [],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@pipeline().parameters.p_airports",
						"type": "Expression"
					},
					"isSequential": true,
					"activities": [
						{
							"name": "Execute API Request Arrival",
							"type": "ExecutePipeline",
							"state": "Inactive",
							"onInactiveMarkAs": "Succeeded",
							"dependsOn": [
								{
									"activity": "Web get_total_arr",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"pipeline": {
									"referenceName": "pl_airline_API_Requests",
									"type": "PipelineReference"
								},
								"waitOnCompletion": true,
								"parameters": {
									"p_airport": {
										"value": "@item()",
										"type": "Expression"
									},
									"p_direction": "arr",
									"p_apiKey": {
										"value": "@pipeline().parameters.p_apiKey",
										"type": "Expression"
									},
									"p_flightDate": {
										"value": "@pipeline().parameters.p_flightDate",
										"type": "Expression"
									},
									"p_ingestionDate": {
										"value": "@pipeline().parameters.p_ingestionDate",
										"type": "Expression"
									},
									"p_runTime": {
										"value": "@pipeline().parameters.p_runTime",
										"type": "Expression"
									},
									"p_total": {
										"value": "@int(activity('Web get_total_arr').output.pagination.total)",
										"type": "Expression"
									}
								}
							}
						},
						{
							"name": "Execute API Request Departure",
							"type": "ExecutePipeline",
							"state": "Inactive",
							"onInactiveMarkAs": "Succeeded",
							"dependsOn": [
								{
									"activity": "Web get_total_dep",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"pipeline": {
									"referenceName": "pl_airline_API_Requests",
									"type": "PipelineReference"
								},
								"waitOnCompletion": true,
								"parameters": {
									"p_airport": {
										"value": "@item()",
										"type": "Expression"
									},
									"p_direction": "dep",
									"p_apiKey": {
										"value": "@pipeline().parameters.p_apiKey",
										"type": "Expression"
									},
									"p_flightDate": {
										"value": "@pipeline().parameters.p_flightDate",
										"type": "Expression"
									},
									"p_ingestionDate": {
										"value": "@pipeline().parameters.p_ingestionDate",
										"type": "Expression"
									},
									"p_runTime": {
										"value": "@pipeline().parameters.p_runTime",
										"type": "Expression"
									},
									"p_total": {
										"value": "@int(activity('Web get_total_dep').output.pagination.total)",
										"type": "Expression"
									}
								}
							}
						},
						{
							"name": "Web get_total_arr",
							"type": "WebActivity",
							"state": "Inactive",
							"onInactiveMarkAs": "Succeeded",
							"dependsOn": [
								{
									"activity": "Copy Departure data source to raw_json",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"method": "GET",
								"url": {
									"value": "@concat(\n'https://api.aviationstack.com/v1/flights?arr_icao=',\nitem(),\n'&flight_date=',pipeline().parameters.p_flightDate,\n'&limit=100',\n'&offset=0',\n'&access_key=',pipeline().parameters.p_apiKey\n\n)",
									"type": "Expression"
								}
							}
						},
						{
							"name": "Web get_total_dep",
							"type": "WebActivity",
							"state": "Inactive",
							"onInactiveMarkAs": "Succeeded",
							"dependsOn": [
								{
									"activity": "Execute API Request Arrival",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"method": "GET",
								"url": {
									"value": "@concat(\n'https://api.aviationstack.com/v1/flights?dep_icao=',\nitem(),\n'&flight_date=',pipeline().parameters.p_flightDate,\n'&limit=100',\n'&offset=0',\n'&access_key=',pipeline().parameters.p_apiKey\n)\n\n",
									"type": "Expression"
								}
							}
						},
						{
							"name": "Copy Arrival data source to raw_json",
							"description": "Queries api endpoint and copies data to json files in ADLS",
							"type": "Copy",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "RestSource",
									"httpRequestTimeout": "00:01:40",
									"requestInterval": "00.00:00:00.010",
									"requestMethod": "GET",
									"paginationRules": {
										"supportRFC5988": "true"
									}
								},
								"sink": {
									"type": "JsonSink",
									"storeSettings": {
										"type": "AzureBlobFSWriteSettings"
									},
									"formatSettings": {
										"type": "JsonWriteSettings"
									}
								},
								"enableStaging": false
							},
							"inputs": [
								{
									"referenceName": "ds_airline_raw_rest",
									"type": "DatasetReference",
									"parameters": {
										"p_access_key": {
											"value": "@pipeline().parameters.p_apiKey",
											"type": "Expression"
										},
										"p_flight_date": {
											"value": "@pipeline().parameters.p_flightDate",
											"type": "Expression"
										},
										"p_direction": "arr",
										"p_airport": {
											"value": "@item()",
											"type": "Expression"
										}
									}
								}
							],
							"outputs": [
								{
									"referenceName": "ds_airline_raw_adls",
									"type": "DatasetReference",
									"parameters": {
										"p_folder": {
											"value": "airlineperformance/flights/@{pipeline().parameters.p_flightDate}",
											"type": "Expression"
										},
										"p_filename": {
											"value": "flights_@{pipeline().parameters.p_flightDate}_@{item()}_arr.json",
											"type": "Expression"
										}
									}
								}
							]
						},
						{
							"name": "Copy Departure data source to raw_json",
							"description": "Queries api endpoint and copies data to json files in ADLS",
							"type": "Copy",
							"dependsOn": [
								{
									"activity": "Copy Arrival data source to raw_json",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "RestSource",
									"httpRequestTimeout": "00:01:40",
									"requestInterval": "00.00:00:00.010",
									"requestMethod": "GET",
									"paginationRules": {
										"supportRFC5988": "true"
									}
								},
								"sink": {
									"type": "JsonSink",
									"storeSettings": {
										"type": "AzureBlobFSWriteSettings"
									},
									"formatSettings": {
										"type": "JsonWriteSettings"
									}
								},
								"enableStaging": false
							},
							"inputs": [
								{
									"referenceName": "ds_airline_raw_rest",
									"type": "DatasetReference",
									"parameters": {
										"p_access_key": {
											"value": "@pipeline().parameters.p_apiKey",
											"type": "Expression"
										},
										"p_flight_date": {
											"value": "@pipeline().parameters.p_flightDate",
											"type": "Expression"
										},
										"p_direction": "dep",
										"p_airport": {
											"value": "@item()",
											"type": "Expression"
										}
									}
								}
							],
							"outputs": [
								{
									"referenceName": "ds_airline_raw_adls",
									"type": "DatasetReference",
									"parameters": {
										"p_folder": {
											"value": "airlineperformance/flights/@{pipeline().parameters.p_flightDate}",
											"type": "Expression"
										},
										"p_filename": {
											"value": "flights_@{pipeline().parameters.p_flightDate}_@{item()}_dep.json",
											"type": "Expression"
										}
									}
								}
							]
						}
					]
				}
			}
		],
		"parameters": {
			"p_ingestionDate": {
				"type": "string",
				"defaultValue": "2026-03-17"
			},
			"p_runTime": {
				"type": "string",
				"defaultValue": "1840"
			},
			"p_flightDate": {
				"type": "string",
				"defaultValue": "2026-03-17"
			},
			"p_apiKey": {
				"type": "string",
				"defaultValue": "92bb3268b5d133d2489e40e3cf3fd07d"
			},
			"p_airports": {
				"type": "array",
				"defaultValue": [
					"MKJP",
					"MKJS",
					"MKBS"
				]
			}
		},
		"folder": {
			"name": "source_raw"
		},
		"annotations": []
	}
}