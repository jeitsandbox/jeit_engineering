								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"method": "GET",
								"url": {
									"value": "@concat(\n'https://api.aviationstack.com/v1/flights?arr_icao=',\nitem(),\n'&limit=100',\n'&offset=0',\n'&access_key=',pipeline().parameters.p_apiKey\n)\n\n",
									"type": "Expression"
								}
							}
						},
						{
							"name": "Web get_total_dep",
