{
	"name": "pl_01_ReadMetadata_master_copy1",
	"properties": {
		"activities": [
			{
				"name": "Read Metadata",
				"type": "GetMetadata",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"dataset": {
						"referenceName": "ds_json_objects",
						"type": "DatasetReference"
					},
					"fieldList": [
						"childItems",
						"itemType",
						"lastModified",
						"exists",
						"itemName"
					],
					"storeSettings": {
						"type": "AzureBlobFSReadSettings",
						"enablePartitionDiscovery": false
					},
					"formatSettings": {
						"type": "JsonReadSettings"
					}
				}
			},
			{
				"name": "Filter1",
				"type": "Filter",
				"dependsOn": [
					{
						"activity": "Read Metadata",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('Read Metadata').output.childItems",
						"type": "Expression"
					},
					"condition": {
						"value": "@contains(item(), '.csv')",
						"type": "Expression"
					}
				}
			}
		],
		"folder": {
			"name": "Quick Sync Metadata"
		},
		"annotations": []
	}
}