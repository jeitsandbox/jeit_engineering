{
	"name": "pl_cs_main",
	"properties": {
		"activities": [
			{
				"name": "flow",
				"type": "ForEach",
				"dependsOn": [],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@pipeline().parameters.p_sources",
						"type": "Expression"
					},
					"isSequential": true,
					"activities": [
						{
							"name": "cs_raw",
							"type": "ExecutePipeline",
							"dependsOn": [
								{
									"activity": "Ingestion DateTime",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"pipeline": {
									"referenceName": "pl_cs_raw",
									"type": "PipelineReference"
								},
								"waitOnCompletion": true,
								"parameters": {
									"p_relativeUrl": {
										"value": "@item().relativeUrl",
										"type": "Expression"
									},
									"p_sinkFolder": {
										"value": "@item().sinkFolder",
										"type": "Expression"
									},
									"p_sourceName": {
										"value": "@item().name",
										"type": "Expression"
									}
								}
							}
						},
						{
							"name": "cs_trusted",
							"type": "ExecutePipeline",
							"dependsOn": [
								{
									"activity": "cs_raw",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"pipeline": {
									"referenceName": "pl_cs_raw_trusted",
									"type": "PipelineReference"
								},
								"waitOnCompletion": true
							}
						},
						{
							"name": "cs_provisioned",
							"type": "ExecutePipeline",
							"dependsOn": [
								{
									"activity": "cs_trusted",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"pipeline": {
									"referenceName": "pl_cs_trusted_provisioned",
									"type": "PipelineReference"
								},
								"waitOnCompletion": true,
								"parameters": {
									"path": {
										"value": "@pipeline().parameters.notebook_path_provisioned",
										"type": "Expression"
									},
									"odate": {
										"value": "@variables('execution_start_time')",
										"type": "Expression"
									}
								}
							}
						},
						{
							"name": "Ingestion DateTime",
							"type": "SetVariable",
							"dependsOn": [],
							"policy": {
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"variableName": "execution_start_time",
								"value": {
									"value": "@utcNow()",
									"type": "Expression"
								}
							}
						}
					]
				}
			}
		],
		"parameters": {
			"environment": {
				"type": "string",
				"defaultValue": "dev"
			},
			"catalog_name": {
				"type": "string",
				"defaultValue": "jeit_kg_dev"
			},
			"schema_name": {
				"type": "string",
				"defaultValue": "trusted_cryptosense"
			},
			"notebook_path": {
				"type": "string",
				"defaultValue": "/Shared/Cryptosense/02_1_Silver_Streaming_AutoLoader"
			},
			"storage_account": {
				"type": "string",
				"defaultValue": "jeitstorageaccountdev"
			},
			"container_name": {
				"type": "string",
				"defaultValue": "raw"
			},
			"bronze_base_path": {
				"type": "string",
				"defaultValue": "cryptosense"
			},
			"checkpoint_base_path": {
				"type": "string",
				"defaultValue": "cryptosense/_checkpoints"
			},
			"schema_location_base_path": {
				"type": "string",
				"defaultValue": "cryptosense/_schemas"
			},
			"p_sources": {
				"type": "array",
				"defaultValue": [
					{
						"name": "coinbase",
						"relativeUrl": "/v2/exchange-rates?currency=USD",
						"sinkFolder": "cryptosense/coinbase/exchange-rates"
					},
					{
						"name": "coingecko",
						"relativeUrl": "/api/v3/coins/markets?vs_currency=usd&order=market_cap_desc&per_page=250&page=1&sparkline=false",
						"sinkFolder": "cryptosense/coingecko/markets"
					}
				]
			},
			"notebook_path_provisioned": {
				"type": "string",
				"defaultValue": "/Shared/Cryptosense/03_Provisioned_Transformations"
			}
		},
		"variables": {
			"execution_start_time": {
				"type": "String",
				"defaultValue": "@utcnow()"
			},
			"should_send_alert": {
				"type": "Boolean",
				"defaultValue": false
			}
		},
		"annotations": []
	}
}